{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fcharset0 Times New Roman;}{\f1\fnil\fcharset0 Calibri;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\cf1\f0\fs24\lang9\par

\pard\qc\ul\b  \fs23 TASK:6 \ulnone\par
\b0\par
\ul\b Solve a Map Coloring problem using constraint satisfaction approach by applying following constraints \ulnone\b0\par

\pard\ul\b Aim: \ulnone\b0 To Solve a Map Coloring problem using constraint satisfaction approach using Graphonline and visualago online simulator.\par
\par
\ul\b Algorithm: \ulnone\b0\par
\b Step 1: \b0 Confirm whether it is valid to color the current vertex worth the current color (by checking whether any of its adjacent vertices are colored with the same color) \par
\b Step 2: \b0 If yes then color it and otherwise try a different color \par
\b Step 3: \b0 check if all vertices are colored or not \par
\b Step 4: \b0 If not then move to the next adjacent uncolored vertex \par
\b Step 5: \b0 Here backtracking means to stop further recursive calls on adjacent vertices. \par
\par
\ul\b Program: \par
\ulnone\b0\par

\pard\qj class Graph:\par
    def __init__(self, vertices):\par
        self.v = vertices\par
        self.graph = [[0 for column in range(vertices)] for row in range(vertices)]\par
\par
    # A utility function to check if the current color assignment is safe for vertex v\par
    def is_safe(self, v, color, c):\par
        for i in range(self.v):\par
            if self.graph[v][i] == 1 and color[i] == c:\par
                return False\par
        return True\par
\par
    # A recursive utility function to solve m-coloring problem\par
    def graph_color_util(self, m, color, v):\par
        if v == self.v:\par
            return True\par
        for c in range(1, m+1):\par
            if self.is_safe(v, color, c):\par
                color[v] = c\par
                if self.graph_color_util(m, color, v+1):\par
                    return True\par
                color[v] = 0\par
        return False\par
\par
    def graph_coloring(self, m):\par
        color = [0] * self.v\par
        if not self.graph_color_util(m, color, 0):\par
            print("Solution does not exist with", m, "colors")\par
            return False\par
\par
        print("Solution exists and following are the assigned colors:")\par
        for c in color:\par
            print(c, end=" ")\par
        print()\par
        return True\par
\par
\par
# Driver Code\par
if __name__ == '__main__':\par
    # Example: Graph with 5 vertices (pentagon)\par
    g = Graph(5)\par
\par
    g.graph = [\par
        [0, 1, 0, 0, 1],  # Vertex 0 connected to 1,4\par
        [1, 0, 1, 0, 0],  # Vertex 1 connected to 0,2\par
        [0, 1, 0, 1, 0],  # Vertex 2 connected to 1,3\par
        [0, 0, 1, 0, 1],  # Vertex 3 connected to 2,4\par
        [1, 0, 0, 1, 0]   # Vertex 4 connected to 0,3\par
    ]\par
\par
    m = 3  # number of colors\par
    g.graph_coloring(m)\par

\pard\ul\b Output:    \par
              \par

