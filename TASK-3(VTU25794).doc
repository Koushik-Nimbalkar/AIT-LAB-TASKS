\pard\sa200\sl276\slmult1\qc\ul\b\f0\fs22\lang9 TASK:3\ulnone\b0\par
\ul\b Implementation of A * Algorithm to find the optimal path using Python by following \par
constraints\ulnone\b0 .\par

\pard\sa200\sl276\slmult1\ul\b 3(A) A* Algorithm\ulnone\b0\par
\ul\b Aim : \ulnone\b0 To implement of A * Algorithm to find the optimal path using Jupiter notebook.\par
\ul\b Algorithm: \ulnone\b0\par
Step 1: start\par
Step 2: Place the starting node into open and find its f(n) [start node] value.\par
Step 3: Remove the node from OPEN, having the smallest f(n) value, if it is x goal node, then \par
stop and return to success.\par
Step 4: Else remove the node from OPEN, and find all its successors.\par
Step 5: Find the f(n) value of all the successors, Place them into OPEN and place the removed \par
node into close\par
Step 6: Go to step 2.\par
Step 7: Exit.\par
\ul\b Program :\ulnone\b0\par
def aStarAlgo(start_node, stop_node):\par
 open_set = set([start_node])\par
 closed_set = set()\par
 g = \{\} # store distance from starting node\par
 parents = \{\} # parents contain an adjacency map of all nodes\par
 # distance of starting node from itself is zero\par
 g[start_node] = 0\par
 # start_node is the root node, so it has no parent nodes\par
 # so start_node is set to its own parent node\par
 parents[start_node] = start_node\par
 while len(open_set) > 0:\par
 n = None\par
 # node with the lowest f() is found\par
 for v in open_set:\par
 if n is None or g[v] + heuristic(v) < g[n] + heuristic(n):\par
 n = v\par
 if n == stop_node or n is None or Graph_nodes[n] is None:\par
 break\par
 else:\par
 for m, weight in get_neighbors(n):\par
 # nodes 'm' not in open_set and closed_set are added to open_set\par
 # n is set as its parent\par
 if m not in open_set and m not in closed_set:\par
 open_set.add(m)\par
 parents[m] = n\par
 g[m] = g[n] + weight\par
 # for each node m, compare its distance from start i.e g(m)\par
 # to the from start through n node\par
 else:\par
 if g[m] > g[n] + weight:\par
 # update g(m)\par
 g[m] = g[n] + weight\par
 # change parent of m to n\par
 parents[m] = n\par
 # if m is in closed_set, remove and add to open_set\par
 if m in closed_set:\par
 closed_set.remove(m)\par
 open_set.add(m)\par
 # remove n from the open_set and add it to closed_set\par
 # because all of its neighbors were inspected\par
 open_set.remove(n)\par
 closed_set.add(n)\par
 if n is None:\par
 print('Path does not exist!')\par
 return None\par
 # if the current node is the stop_node,\par
 # then we begin reconstructing the path from it to the start_node\par
 if n == stop_node:\par
 path = []\par
 while parents[n] != n:\par
 path.append(n)\par
 n = parents[n]\par
 path.append(start_node)\par
 path.reverse()\par
 print('Path found:', path)\par
 return path\par
 print('Path does not exist!')\par
 return None\par
# define function to return neighbors and their distances from the passed node\par
def get_neighbors(v):\par
 if v in Graph_nodes:\par
 return Graph_nodes[v]\par
 else:\par
 return None\par
# for simplicity, we'll consider heuristic distances given\par
# and this function returns heuristic distance for all nodes\par
Graph_nodes = \{\par
    "A": [("B", 4), ("C", 2)],\par
    "B": [("A", 4), ("D", 5), ("E", 10)],\par
    "C": [("A", 2), ("D", 8), ("F", 4)],\par
    "D": [("B", 5), ("C", 8), ("E", 2), ("G", 6)],\par
    "E": [("B", 10), ("D", 2), ("H", 3)],\par
    "F": [("C", 4), ("G", 1)],\par
    "G": [("D", 6), ("F", 1), ("H", 7)],\par
    "H": [("E", 3), ("G", 7), ("J", 5)],\par
    "J": [("H", 5)]\par
\}\par
\par
def heuristic(n):\par
    h_dist = \{\par
        "A": 14,\par
        "B": 12,\par
        "C": 11,\par
        "D": 6,\par
        "E": 4,\par
        "F": 11,\par
        "G": 5,\par
        "H": 3,\par
        "J": 0\par
    \}\par
    return h_dist[n]\par
\par
print("Following is the A* Algorithm:")\par
aStarAlgo("A", "J")\par
\ul\b Output:\par
\ulnone\b0 Following is the A* Algorithm:\par
Path found: ['A', 'C', 'F', 'G', 'H', 'J']\par
\ul\b Result:\ulnone\b0\par
Thus the Implementation of A * Algorithm to find the optimal path using Python Was \par
successfully executed and output was verified.\par
\ul\b 3(B) \f1\endash  Simplified A* Algorithm.\ulnone\b0\par
\ul\b Aim: \ulnone\b0 To implement the simplified A*Algorithm using Jupiter notebook.\par
\ul\b Algorithm: \ulnone\b0\par
Step 1 : start.\par
Step 2: place the starting node into open and find its f(n) value\par
Step 3: Remove the node from OPEN , having the smallest f(n) value, if it is a goal node , then \par
stop and return to success.\par
Step 4: else remove the node from OPEN, and find all its successors\par
Step 5:Find the f(n) value of all the successors, Place them into OPEN and place the removed \par
node into close\par
Step 6: Go to step 2.\par
Step 7: Exit.\par
\ul\b Program: \par
\ulnone\b0 def aStarAlgo(start_node, stop_node):\par
 open_set = set([start_node])\par
 closed_set = set()\par
 g = \{\} # store distance from starting node\par
 parents = \{\} # parents contain an adjacency map of all nodes\par
 # distance of starting node from itself is zero\par
 g[start_node] = 0\par
 # start_node is the root node, so it has no parent nodes\par
 # so start_node is set to its own parent node\par
 parents[start_node] = start_node\par
 while len(open_set) > 0:\par
 n = None\par
 # node with the lowest f() is found\par
 for v in open_set:\par
 if n is None or g[v] + heuristic(v) < g[n] + heuristic(n):\par
 n = v\par
 if n == stop_node or n is None or n not in Graph_nodes:\par
 break\par
 else:\par
 for m, weight in get_neighbors(n):\par
 # nodes 'm' not in open_set and closed_set are added to open_set\par
 # n is set as its parent\par
 if m not in open_set and m not in closed_set:\par
 open_set.add(m)\par
 parents[m] = n\par
 g[m] = g[n] + weight\par
 # for each node m, compare its distance from start i.e g(m)\par
 # to the from start through n node\par
 else:\par
 if g[m] > g[n] + weight:\par
 # update g(m)\par
 g[m] = g[n] + weight\par
 # change parent of m to n\par
 parents[m] = n\par
 # if m is in closed_set, remove and add to open_set\par
 if m in closed_set:\par
 closed_set.remove(m)\par
 open_set.add(m)\par
 # remove n from the open_set and add it to closed_set\par
 # because all of its neighbors were inspected\par
 open_set.remove(n)\par
 closed_set.add(n)\par
 if n is None:\par
 print('Path does not exist!')\par
 return None\par
 # if the current node is the stop_node,\par
 # then we begin reconstructing the path from it to the start_node\par
 if n == stop_node:\par
 path = []\par
 while parents[n] != n:\par
 path.append(n)\par
 n = parents[n]\par
 path.append(start_node)\par
 path.reverse()\par
 print('Path found:', path)\par
 return path\par
 print('Path does not exist!')\par
 return None\par
# define function to return neighbors and their distances from the passed node\par
def get_neighbors(v):\par
 if v in Graph_nodes:\par
 return Graph_nodes[v]\par
 else:\par
 return None\par
# for simplicity, we'll consider heuristic distances given\par
# and this function returns heuristic distance for all nodes\par
Graph_nodes = \{\par
    'A': [('B', 1), ('C', 4)],\par
    'B': [('A', 1), ('D', 2), ('E', 5)],\par
    'C': [('A', 4), ('F', 3)],\par
    'D': [('B', 2), ('G', 6)],\par
    'E': [('B', 5), ('G', 2)],\par
    'F': [('C', 3), ('G', 2)],\par
    'G': [('D', 6), ('E', 2), ('F', 2)]\par
\}\par
def heuristic(n):\par
    h_dist = \{\par
        'A': 10,\par
        'B': 8,\par
        'C': 5,\par
        'D': 4,\par
        'E': 3,\par
        'F': 2,\par
        'G': 0\par
    \}\par
    return h_dist[n]\par
print("Following is the A* Algorithm:")\par
aStarAlgo('A', 'G')\par
\ul\b\f0\lang1033 Output:\par
\ulnone\b0 Path found: ['A', 'B', 'E', 'G']\f1\lang9\par
\ul\b Result:\ulnone\b0\par
Thus the implementation of the simplified A*Algorithm using Jupiter notebook was \par
successfully executed and output was verified.\f0\par
